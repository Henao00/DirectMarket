# DirectMarket - Variables de Entorno
# Copiar como .env y completar valores antes de ejecutar

# Servidor
NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=directmarket_db
DB_USER=directmarket_user
DB_PASSWORD=your_secure_password_here

# JWT - Usar secreto largo y aleatorio en produccion
JWT_SECRET=your_very_long_random_jwt_secret_at_least_64_characters_long
JWT_EXPIRES_IN=7d

# Codigo de liberacion
# Tiempo de expiracion en horas (RNF-02: maximo 24 horas)
RELEASE_CODE_EXPIRY_HOURS=24
# Maximo intentos antes de bloqueo (CP-008: 3 intentos)
RELEASE_CODE_MAX_ATTEMPTS=3

# Bloqueo de cuenta por intentos fallidos de login
# CP-002: bloqueo tras 5 intentos por 15 minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15

# Email (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@directmarket.com
SMTP_PASS=your_smtp_password

# Frontend URL (para CORS y links en emails)
FRONTEND_URL=http://localhost:3000

# Encriptacion de datos financieros (RNF-01)
ENCRYPTION_KEY=your_32_character_encryption_key_here
